<%%

    prefix = "wander.trader_dimension"
%%>

function load {
    scoreboard objectives add <%prefix%> dummy
    scoreboard objectives add <%prefix%>.scale dummy
    scoreboard objectives add <%prefix%>.mob_duration dummy
    scoreboard objectives add <%prefix%>.cooldown dummy
    scoreboard objectives add <%prefix%>.freedom_timer dummy
    scoreboard objectives add <%prefix%>.chests_opened dummy
}

function tick {

    execute as @a[tag=<%prefix%>.leaving] at @s if entity abb5e532-ba94-447e-8b50-7b463008a14c run {
        tag abb5e532-ba94-447e-8b50-7b463008a14c remove wander.force_kidnap
        tag @s remove <%prefix%>.leaving
    }
    execute if score daytime wander.data matches -501 run tag @a[tag=<%prefix%>.leaving] remove <%prefix%>.leaving

    execute as @a at @s unless dimension wander:pocket run scoreboard players set @s <%prefix%>.chests_opened 0

    execute if predicate {"condition":"minecraft:random_chance","chance":0.005} as @n[tag=<%prefix%>.spawn,x=0] at @s unless entity @p[distance=0..10] unless entity @n[tag=aj.wander_chest.root,type=item_display,distance=0..2] run function aj:wander_chest/animations/open/play
    execute if score bad_omen wander.data matches 1 if predicate {"condition":"minecraft:random_chance","chance":0.04} as @n[tag=<%prefix%>.spawn,x=0] at @s unless entity @p[distance=0..10] unless entity @n[tag=aj.wander_chest.root,type=item_display,distance=0..2] run {
        tag @s add <%prefix%>.better_random
        function aj:wander_chest/animations/open/play
    }

    execute unless entity @p[x=0] run {
        function aj:wander_chest/remove/all
        kill @e[tag=aj.wander_chest.node,x=0]
        tp @e[type=item,x=0] abb5e532-ba94-447e-8b50-7b463008a14c
    }
    execute as @e[tag=<%prefix%>.spawn,x=0] at @s run {
        execute if entity @p[distance=0..20] unless entity @n[tag=aj.wander_chest.root,type=item_display,distance=0..2] run function aj:wander_chest/summon {args:{animation:'idle',start_animation:true}}
        execute unless entity @p[distance=0..20] if entity @n[tag=aj.wander_chest.root,type=item_display,distance=0..2] as @n[tag=aj.wander_chest.root,type=item_display,distance=0..2] run function aj:wander_chest/remove/this
    }
    # execute if entity @p[x=0] unless entity @n[tag=aj.wander_chest.root,x=0] run function spawn_chests
    execute as @e[tag=<%prefix%>.mob,x=0] at @s run function chest/mob_tick
    execute as @e[tag=aj.wander_chest.node.hitbox,scores={<%prefix%>.cooldown=1..}] at @s run {
        scoreboard players remove @s <%prefix%>.cooldown 1
        execute if score @s <%prefix%>.cooldown matches 1 run data merge entity @s {width:1.125,height:1.125}
    } 
    execute as @a[x=0] at @s run {

        execute if predicate {"condition":"minecraft:entity_properties","entity":"this","predicate":{"location":{"position":{"y":{"max":-70}}}}} run {
            tp @s ~ -50 ~
            effect give @s resistance 20 60 true
        }
        
        attribute @s minecraft:block_interaction_range modifier add wander:pocket -10 add_multiplied_total
        # execute if predicate {"condition":"minecraft:all_of","terms":[{"condition":"minecraft:random_chance","chance":0.3},{"condition":"minecraft:entity_properties","entity":"this","predicate":{"periodic_tick":500}}]} run playsound wander:pocket.ambience hostile @s ~ ~ ~ 0.8 1.0 1.0
        scoreboard players remove @s[scores={<%prefix%>.freedom_timer=1..}] <%prefix%>.freedom_timer 1
        execute if score @s <%prefix%>.freedom_timer matches 40 run title @s[tag=!wander.debug] times 30 10 10
        execute if score @s <%prefix%>.freedom_timer matches 40 run title @s[tag=!wander.debug] title {text:"\uFF00",font:"wander:default",color:"white"}
        execute if score @s <%prefix%>.freedom_timer matches 1 run function leave
    }
    execute as @a at @s unless dimension wander:pocket run {
        attribute @s minecraft:block_interaction_range modifier remove wander:pocket
        tag @s remove <%prefix%>.must_check
    }

    execute unless entity @n[tag=aj.fine_print.root,x=0] if entity @n[tag=<%prefix%>.light,x=0] run function scan/remove_light



}

function spawn_chests {
    function aj:wander_chest/remove/all
    kill @e[tag=aj.wander_chest.node]
    execute in wander:pocket as @e[tag=<%prefix%>.spawn,x=0] at @s run function aj:wander_chest/summon {args:{animation:'idle',start_animation:true}}
}

function leave {
    # runs as player, will cause them to leave.
    tag @s add <%prefix%>.leaving
    scoreboard players set kidnap wander.attack_cooldown 400
    execute if score ai wander.fine_print matches 1 run scoreboard players set timer wander.fine_print 200
    # old code
    execute unless entity @n[tag=aj.wander.locator.chest] run return run { with storage wander:temp kidnap_pos
        $execute in minecraft:overworld run tp @s $(x) $(y) $(z)
        attribute @s scale modifier add wander:escape -0.95 add_multiplied_total
        scoreboard players set $strength player_motion.api.launch 10000
        execute rotated ~ -12 run function player_motion:api/launch_looking
        effect give @s slow_falling 5 0 true
        function wander:grow_init
        scoreboard players set attack_cd wander.data 150
    }
    execute in minecraft:overworld at @n[tag=aj.wander.locator.chest] run tp @s ~ ~ ~
    attribute @s scale modifier add wander:escape -0.95 add_multiplied_total
    scoreboard players set $strength player_motion.api.launch 10000
    execute rotated ~ -12 run function player_motion:api/launch_looking
    effect give @s slow_falling 5 0 true
    function wander:grow_init
    scoreboard players set attack_cd wander.data 350




}


dir lights {
    function off {
        gamerule minecraft:max_block_modifications 2514337
        execute in wander:pocket run fillbiome -80 -64 -80 80 32 80 wander:lights_off
    }

    function on {
        gamerule minecraft:max_block_modifications 2514337
        execute in wander:pocket run fillbiome -80 -64 -80 80 32 80 wander:void
    }
}


dir chest {

    function select_random {
        
        execute if score bad_omen wander.data matches 1 run return run {
            execute store result score random_event <%prefix%> run random value 0..40
            
            execute if score random_event <%prefix%> matches 1..19 run return run function mob
            
            execute if score random_event <%prefix%> matches 20..29 run return run function nothing
            execute if score random_event <%prefix%> matches 30..31 run return run function ../scan/init

            execute if score random_event <%prefix%> matches 32..40 run return run function escape
        }
        execute store result score random_event <%prefix%> run random value 0..20
        execute if score random_event <%prefix%> matches 1..12 run return run function mob
        execute if entity @p[distance=0..20] if score random_event <%prefix%> matches 13 run return run function ../scan/init
        
        execute if score random_event <%prefix%> matches 14..18 run return run function nothing
        execute if score random_event <%prefix%> matches 19..20 run return run function escape

    }

    function mob_tick {
        execute unless score @s <%prefix%>.scale matches 21.. run scoreboard players add @s <%prefix%>.scale 1
        execute unless score @s <%prefix%>.scale matches 21.. store result entity @s attributes[{id:"minecraft:scale"}].base float 0.05 run scoreboard players get @s <%prefix%>.scale


        scoreboard players add @s <%prefix%>.mob_duration 1
        execute if score @s <%prefix%>.mob_duration matches 400.. run {
            particle minecraft:campfire_cosy_smoke ~ ~1 ~ 0.5 0.5 0.5 0.05 50 normal @a

            tp @s ~ ~-1000 ~
            kill @s
        }
    }
    # random mob, aka zombie, skeleton, spider, vex, trader llamas, witch

    # bomb like from the bag (since it dont damage blocks)

    # cause lights to go out

    # do nothing (particles?)

    # provide escape

    function mob {
        execute store result score random <%prefix%> run random value 0..6

        execute if score random wander.trader_dimension matches 0 run summon zombie ~ ~ ~ {Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling"],attributes:[{base:0.1,id:"scale"}],drop_chances:{chest:0,head:0,feet:0,legs:0,mainhand:0,offhand:0}}
        execute if score random wander.trader_dimension matches 1 run summon skeleton ~ ~ ~ {equipment:{mainhand:{id:"bow",count:1}},Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling"],attributes:[{base:0.1,id:"scale"}],drop_chances:{chest:0,head:0,feet:0,legs:0,mainhand:0,offhand:0}}
        execute if score random wander.trader_dimension matches 2 run summon spider ~ ~ ~ {Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling"],attributes:[{base:0.1,id:"scale"}]}
        execute if score random wander.trader_dimension matches 3 run summon vex ~ ~ ~ {Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling"],attributes:[{base:0.1,id:"scale"}]}
        execute if score random wander.trader_dimension matches 4 run summon trader_llama ~ ~ ~ {Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling"],attributes:[{base:0.1,id:"scale"}]}
        execute if score random wander.trader_dimension matches 5 run summon witch ~ ~ ~ {Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling"],attributes:[{base:0.1,id:"scale"}]}
        execute if score random wander.trader_dimension matches 6 run summon creaking ~ ~ ~ {Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling"],attributes:[{base:0.1,id:"scale"},{base:30,id:"max_health"}],Health:30}
        execute if score random wander.trader_dimension matches 7 run summon tnt ~ ~ ~ {Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling","wander.from_bag"]}

        execute if score bad_omen wander.data matches 1 if score random wander.trader_dimension matches 0 run summon zombie ~ ~ ~ {Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling"],attributes:[{base:0.1,id:"scale"}],drop_chances:{chest:0,head:0,feet:0,legs:0,mainhand:0,offhand:0}}
        execute if score bad_omen wander.data matches 1 if score random wander.trader_dimension matches 1 run summon skeleton ~ ~ ~ {equipment:{mainhand:{id:"bow",count:1}},Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling"],attributes:[{base:0.1,id:"scale"}],drop_chances:{chest:0,head:0,feet:0,legs:0,mainhand:0,offhand:0}}
        execute if score bad_omen wander.data matches 1 if score random wander.trader_dimension matches 2 run summon spider ~ ~ ~ {Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling"],attributes:[{base:0.1,id:"scale"}]}
        execute if score bad_omen wander.data matches 1 if score random wander.trader_dimension matches 3 run summon vex ~ ~ ~ {Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling"],attributes:[{base:0.1,id:"scale"}]}
        execute if score bad_omen wander.data matches 1 if score random wander.trader_dimension matches 4 run summon trader_llama ~ ~ ~ {Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling"],attributes:[{base:0.1,id:"scale"}]}
        execute if score bad_omen wander.data matches 1 if score random wander.trader_dimension matches 5 run summon witch ~ ~ ~ {Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling"],attributes:[{base:0.1,id:"scale"}]}
        execute if score bad_omen wander.data matches 1 if score random wander.trader_dimension matches 6 run summon creaking ~ ~ ~ {Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling"],attributes:[{base:0.1,id:"scale"},{base:30,id:"max_health"}],Health:30}
        execute if score bad_omen wander.data matches 1 if score random wander.trader_dimension matches 7 run summon tnt ~ ~ ~ {Tags:["<%prefix%>.mob","<%prefix%>.new","<%prefix%>.scaling","wander.from_bag"]}




        execute as @e[tag=<%prefix%>.mob,tag=<%prefix%>.new,distance=0..0.1] at @s run {
            execute if score bad_omen wander.data matches 1 unless entity @s[type=!zombie,type=!skeleton] run function ../gear/random_gear
            execute store result entity @s Motion[0] double 0.1 run random value 3..8
            execute if predicate {"condition":"minecraft:random_chance","chance":0.5} store result entity @s Motion[0] double 0.1 run random value -8..-3

            execute store result entity @s Motion[1] double 0.1 run random value 3..8

            execute store result entity @s Motion[2] double 0.1 run random value 3..8
            execute if predicate {"condition":"minecraft:random_chance","chance":0.5} store result entity @s Motion[2] double 0.1 run random value -8..-3

            tag @s remove <%prefix%>.new
        }
    }

    function nothing {
        execute if predicate {"condition":"minecraft:random_chance","chance":0.75} run particle minecraft:campfire_cosy_smoke ~ ~1 ~ 0.5 0.5 0.5 0.05 50 normal @a
    }

    function escape {
        function aj:wander_chest/variants/freedom/apply
        scoreboard players set @a[distance=0..5] <%prefix%>.freedom_timer 50
    }

}

dir gear {
function random_gear {
        function equip_gear {slot:"armor.head",armor:"helmet"}
        function equip_gear {slot:"armor.chest",armor:"chestplate"}
        function equip_gear {slot:"armor.legs",armor:"leggings"}
        function equip_gear {slot:"armor.feet",armor:"boots"}

        function equip_weapon {slot:"weapon.mainhand",tool:"sword"}
        execute if predicate {"condition":"minecraft:random_chance","chance":0.33} run function equip_weapon {slot:"weapon.mainhand",tool:"axe"}
    }

    function equip_gear {
        $execute if predicate {"condition":"minecraft:random_chance","chance":0.5} run return run item replace entity @s $(slot) with leather_$(armor)
        $execute if predicate {"condition":"minecraft:random_chance","chance":0.5} run return run item replace entity @s $(slot) with chainmail_$(armor)
        $execute if predicate {"condition":"minecraft:random_chance","chance":0.5} run return run item replace entity @s $(slot) with copper_$(armor)
        $execute if predicate {"condition":"minecraft:random_chance","chance":0.4} run return run item replace entity @s $(slot) with iron_$(armor)
        $execute if predicate {"condition":"minecraft:random_chance","chance":0.3} run return run item replace entity @s $(slot) with golden_$(armor)
        $execute if predicate {"condition":"minecraft:random_chance","chance":0.2} run return run item replace entity @s $(slot) with diamond_$(armor)
        $execute if predicate {"condition":"minecraft:random_chance","chance":0.05} run return run item replace entity @s $(slot) with netherite_$(armor)

    }

    function equip_weapon {
        execute if items entity @s weapon.mainhand bow run return 0
        $execute if predicate {"condition":"minecraft:random_chance","chance":0.5} run return run item replace entity @s $(slot) with wooden_$(tool)
        $execute if predicate {"condition":"minecraft:random_chance","chance":0.5} run return run item replace entity @s $(slot) with stone_$(tool)
        $execute if predicate {"condition":"minecraft:random_chance","chance":0.5} run return run item replace entity @s $(slot) with copper_$(tool)
        $execute if predicate {"condition":"minecraft:random_chance","chance":0.4} run return run item replace entity @s $(slot) with iron_$(tool)
        $execute if predicate {"condition":"minecraft:random_chance","chance":0.3} run return run item replace entity @s $(slot) with golden_$(tool)
        $execute if predicate {"condition":"minecraft:random_chance","chance":0.2} run return run item replace entity @s $(slot) with diamond_$(tool)
        $execute if predicate {"condition":"minecraft:random_chance","chance":0.05} run return run item replace entity @s $(slot) with netherite_$(tool)

    }
}

dir scan {
    function init {
        execute if score scan_active <%prefix%> matches 1 run return 0
        scoreboard players set scan_active <%prefix%> 1
        stopsound @a[x=0] ambient
        playsound wander:phase3.emerald_stop hostile @a[x=0] ~ ~ ~ 20.0 0.7 1.0
        playsound wander:phase3.emerald_stop hostile @a[x=0] ~ ~ ~ 20.0 0.7 1.0
        playsound wander:phase3.emerald_stop hostile @a[x=0] ~ ~ ~ 20.0 0.7 1.0
        playsound wander:phase3.emerald_stop hostile @a[x=0] ~ ~ ~ 20.0 0.7 1.0
        # function wander:fine_print/set_teleport_duration {duration:50}
        function ../lights/off

        scoreboard players set scan_timer <%prefix%> 219
        schedule function 1 3s
    }

    function 1 {
        # hide text, display timer.
        execute in wander:pocket run {
            scoreboard players remove scan_timer <%prefix%> 1

            scoreboard players operation scan_seconds <%prefix%> = scan_timer <%prefix%>
            scoreboard players set 20 <%prefix%> 20
            scoreboard players operation scan_seconds <%prefix%> /= 20 <%prefix%>

            scoreboard players operation scan_ticks <%prefix%> = scan_timer <%prefix%>
            scoreboard players set 20 <%prefix%> 20
            scoreboard players operation scan_ticks <%prefix%> %= 20 <%prefix%>

            execute if score scan_timer <%prefix%> matches 218 as @a[x=0] at @s run playsound wander:pocket.tick hostile @s ~ ~ ~ 1.0 1.0 1.0

            execute if score scan_seconds <%prefix%> matches 7.. if score scan_ticks <%prefix%> matches 0 as @a[x=0] at @s run playsound wander:pocket.tick hostile @s ~ ~ ~ 1.0 0.86 1.0
            execute if score scan_seconds <%prefix%> matches 4..6 if score scan_ticks <%prefix%> matches 0 as @a[x=0] at @s run playsound wander:pocket.tick hostile @s ~ ~ ~ 1.0 0.7 1.0
            execute if score scan_seconds <%prefix%> matches 0..3 if score scan_ticks <%prefix%> matches 0 as @a[x=0] at @s run playsound wander:pocket.tick hostile @s ~ ~ ~ 1.0 0.5 1.0
            title @a[x=0] times 0 20 1
            title @a[x=0] actionbar ["",{color:"dark_red",text:"Find cover in ",extra:[{score:{name:"scan_seconds",objective:"<%prefix%>"}}," seconds."]}]
            execute unless score scan_timer <%prefix%> matches 1.. run title @a[x=0] actionbar ["",{color:"dark_red",text:"Hide."}]

        }
        execute if score scan_timer <%prefix%> matches 1.. run return run schedule function 1 1t
        schedule function 2 1s
        
        
    }

    function 2 {
        # spawn the thing at 0,0 but above. play a sound effect.
        # tag all players to make sure they're checked.
        execute in wander:pocket run {
            execute positioned 0 -30 0 run function aj:fine_print/summon {args:{variant:'invisible',start_animation:true,animation:'pocket_enter'}}
            # execute as @n[tag=aj.fine_print.root,x=0] run function wander:fine_print/set_teleport_duration {duration:50} 
            tag @a[gamemode=!creative,gamemode=!spectator,x=0] add <%prefix%>.must_check
        }
        schedule function 3 3s
    }

    function 3 {
        # teleport to random "<%prefix%>.must_check" player
        # use schedule to 60 ticks, then check that player for 2 seconds.
        # after checking, give player special tag, where if they are exposed with that tag, they get "must check" again

        execute in wander:pocket run {
            execute as @n[tag=aj.fine_print.root,x=0] at @s run {
                playsound wander:phase3.emerald_hum hostile @a[x=0] ~ ~ ~ 20.0 1.0 1.0
                function aj:fine_print/variants/default/apply
                function aj:fine_print/variants/invisible/apply
                tag @r[tag=<%prefix%>.must_check,x=0] add <%prefix%>.scan_target
                tag @p[tag=<%prefix%>.scan_target] remove <%prefix%>.must_check
                execute facing entity @p[tag=<%prefix%>.scan_target,x=0] eyes at @p[tag=<%prefix%>.scan_target,x=0] positioned over motion_blocking positioned ~ ~20 ~ run tp @s ~ ~ ~ ~ 0
            }
            scoreboard players set check_timer <%prefix%> 40
            schedule function 4 3s
        }

    }

    function 4 {
        execute in wander:pocket run {
            # checking
            execute as @n[tag=aj.fine_print.root,x=0] at @s run function light_raycast
            execute as @a[tag=<%prefix%>.scan_target] at @s if predicate {"condition":"minecraft:location_check","predicate":{"can_see_sky":true}} run function caught
            scoreboard players remove check_timer <%prefix%> 1
            execute if score check_timer <%prefix%> matches 1.. run return run schedule function 4 1t
            # checking done
            execute as @n[tag=aj.fine_print.root,x=0] at @s run function remove_light
            
            tag @a[tag=<%prefix%>.scan_target] remove <%prefix%>.scan_target
            
            # find a new player

            execute if entity @p[tag=<%prefix%>.must_check,x=0] run return run schedule function 3 1s
            
            # no players left to check
            schedule function end 1s
        }
    }



    function end {
        
        execute in wander:pocket run {
            scoreboard players set scan_active <%prefix%> 0
            playsound wander:phase3.emerald_stop hostile @a[x=0] 0 0 0 20.0 1.4 1.0
            playsound wander:phase3.emerald_stop hostile @a[x=0] 0 0 0 20.0 1.4 1.0
            playsound wander:phase3.emerald_stop hostile @a[x=0] 0 0 0 20.0 1.4 1.0
            tag @a remove <%prefix%>.must_check
            tag @a remove <%prefix%>.scan_target
            execute as @n[tag=aj.fine_print.root,x=0] run function aj:fine_print/animations/pocket_leave/play
        }
        function ../lights/on
    }

    function caught {
        playsound wander:fine_print.hit_item hostile @a[x=0] ~ ~ ~ 10 0.7 0.5
        particle minecraft:totem_of_undying ~ ~1 ~ 0 0 0 0.3 40 normal @a
        particle minecraft:gust ~ ~1 ~ 0 0 0 0.0 1 normal @a
        effect give @s wither 10 3 false
        effect give @s hunger 10 5 false
        playsound minecraft:entity.wandering_trader.no hostile @a[x=0] ~ ~20 ~ 10.0 0.6 1.0
        scoreboard players set check_timer <%prefix%> 0
        execute as @n[tag=aj.fine_print.root,x=0] run function aj:fine_print/variants/sad_mask/apply
    }
    
    function light_raycast {
        execute as @e[tag=<%prefix%>.light,x=0] at @s if block ~ ~ ~ light run setblock ~ ~ ~ air strict
        kill @e[tag=<%prefix%>.light,x=0]
        execute if block ~ ~ ~ air run {

            summon marker ~ ~ ~ {Tags:["<%prefix%>.light"]}
            execute positioned ~ ~-1 ~ if block ~ ~ ~ air if entity @s[distance=0..30] run function ^0
        }
        execute as @e[tag=<%prefix%>.light,x=0] at @s if block ~ ~ ~ air run setblock ~ ~ ~ light strict
        
    }

    function remove_light {
        execute as @e[tag=<%prefix%>.light,x=0] at @s if block ~ ~ ~ light run setblock ~ ~ ~ air strict
        kill @e[tag=<%prefix%>.light,x=0]
        
    }
}

advancement chest_interact {
	"criteria": {
		"a": {
			"trigger": "minecraft:player_interacted_with_entity",
			"conditions": {
				"entity": {
					"nbt": "{Tags:[\"aj.wander_chest.node.hitbox\"]}"
				}
			}
		}
	},
	"requirements": [
		[
			"a"
		]
	],
	"rewards": {
		"function": "wander:trader_dimension/chest_interact"
	}
}

function chest_interact {
    advancement revoke @s only wander:trader_dimension/chest_interact

    scoreboard players add @s <%prefix%>.chests_opened 1
    schedule 5s replace {
        execute in wander:pocket as @a[scores={<%prefix%>.chests_opened=8..}] at @s run function chest/escape
    }
    execute as @e[tag=aj.wander_chest.node.hitbox,distance=0..5] if data entity @s interaction run {
        data remove entity @s interaction
        execute at @s as @n[tag=aj.wander_chest.root] run function aj:wander_chest/animations/open/play
    }
}